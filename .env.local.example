# Convex
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...
CLERK_SECRET_KEY=sk_test_...

# ============================================
# Convex Environment Variables
# Set these via: npx convex env set VAR_NAME value
# ============================================

# Clerk JWT (required for auth)
# CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev

# Google Vertex AI (required for interview LLM)
# GOOGLE_VERTEX_PROJECT=your-gcp-project-id
# GOOGLE_VERTEX_LOCATION=us-central1
# GOOGLE_CLIENT_EMAIL=your-sa@project.iam.gserviceaccount.com
# GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# GitHub OAuth (for repo creation - Phase 4)
# GITHUB_CLIENT_ID=...
# GITHUB_CLIENT_SECRET=...

# Tavily (web search for interview AI - Phase 3)
# TAVILY_API_KEY=tvly-...

# Daytona (for template customization - Phase 5)
# DAYTONA_API_KEY=dtn_...
# DAYTONA_API_URL=https://api.daytona.io
